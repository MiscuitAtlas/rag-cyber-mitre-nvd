# Copier en .env pour changer un réglage ; toutes les valeurs ci-dessous sont les valeurs par défaut.

# Dossiers
RAG_RAW_DIR=data/raw
RAG_DATA_DIR=data/processed
RAG_INDEX_DIR=vectorstore/faiss_index
RAG_EVAL_DIR=data/eval

# Découpage et recherche
RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=120
RAG_CHUNK_OVERLAP=30
RAG_TOP_K=5
RAG_CANDIDATES=10
RAG_HYBRID_ALPHA=0.6

# LLM local (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
RAG_TEMPERATURE=0.0
RAG_SEED=42
RAG_NUM_CTX=4096
RAG_TIMEOUT=180
